# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.cs text diff=csharp eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.xml text eol=crlf
*.xaml text eol=crlf
*.json text eol=crlf
*.config text eol=crlf
*.manifest text eol=crlf

# Web frontend
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Images and binaries
*.ico binary
*.png binary
*.jpg binary
*.svg binary
*.ttf binary
*.woff2 binary

# Build / lock files
*.nuget.targets text eol=crlf
