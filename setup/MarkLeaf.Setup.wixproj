<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Msi</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>zh-CN</Cultures>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <Suffix Condition="'$(SelfContained)' == 'false'">fd</Suffix>
    <OutputName>MarkLeaf-$(Version)-x64$(Suffix)</OutputName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Heat" Version="5.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepoRoot>
    <PublishDir>$(RepoRoot)\obj\publish-$(SelfContained)\</PublishDir>
    <DefineConstants>PublishSource=$(PublishDir);SelfContained=$(SelfContained)</DefineConstants>
  </PropertyGroup>

  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Publishing MarkLeaf (win-x64, self-contained=$(SelfContained))..." />
    <Exec Command="dotnet publish &quot;$(RepoRoot)\src\MarkLeaf\MarkLeaf.csproj&quot; -c Release -r win-x64 --self-contained $(SelfContained) -o &quot;$(PublishDir)&quot;"
          WorkingDirectory="$(RepoRoot)" />
  </Target>

  <Target Name="RenameMsi" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetPath).msi" />
    <Message Importance="high" Text="MSI: $(TargetPath).msi" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="zh-CN.wxl" />

    <HarvestDirectory Include="$(PublishDir)">
      <ComponentGroupName>PublishedComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <PreprocessorVariable>var.PublishSource</PreprocessorVariable>
    </HarvestDirectory>
  </ItemGroup>
</Project>
