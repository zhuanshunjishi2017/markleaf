<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="MarkLeaf"
           Manufacturer="MarkLeaf"
           Version="$(var.ProductVersion)"
           UpgradeCode="E1B2C3D4-1234-5678-9ABC-DEF012345678"
           Scope="perMachine"
           Compressed="yes"
           Codepage="936">

    <MajorUpgrade DowngradeErrorMessage="已安装的 MarkLeaf 版本更新，无法降级。请先卸载当前版本再重试。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- ===== Install Wizard UI (欢迎 → 许可 → 目录 → 确认 → 进度) ===== -->
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
    </UI>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ===== Prerequisites (framework-dependent only) ===== -->
<?if $(var.SelfContained) = false ?>
    <Property Id="DOTNET_ROOT">
      <RegistrySearch Id="DotNetHostSearch"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Version"
                      Type="raw" />
    </Property>
    <Launch Condition="DOTNET_ROOT"
            Message="需要 .NET 10 桌面运行时才能运行 MarkLeaf。请从 https://dotnet.microsoft.com/download 下载安装。" />
<?endif ?>

    <!-- ===== Single feature: everything always installed ===== -->
    <Feature Id="MainApp" Title="MarkLeaf" Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="PublishedComponents" />
      <ComponentRef Id="ProgIdRegistration" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="MarkdownFileAssociation" />
      <ComponentRef Id="MarkdownAltFileAssociation" />
      <ComponentRef Id="TextFileAssociation" />
    </Feature>

    <!-- ===== Directory Layout ===== -->
<?if $(var.Runtime) = win-x86 ?>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="MarkLeaf" />
    </StandardDirectory>
<?else ?>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MarkLeaf" />
    </StandardDirectory>
<?endif ?>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuMarkLeaf" Name="MarkLeaf" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- ===== Start Menu Shortcut ===== -->
    <Component Id="ApplicationShortcut" Directory="StartMenuMarkLeaf"
               Guid="D1A2B3C4-5678-90AB-CDEF-123456789001">
      <Shortcut Id="StartMenuShortcut"
                Name="MarkLeaf"
                Target="[INSTALLFOLDER]MarkLeaf.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKMU" Key="Software\MarkLeaf"
                     Name="StartMenuInstalled" Value="1" Type="integer" KeyPath="yes" />
      <RemoveFolder Id="RemoveStartMenu" Directory="StartMenuMarkLeaf" On="uninstall" />
    </Component>

    <!-- ===== Desktop Shortcut ===== -->
    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder"
               Guid="D6A7B8C9-0123-DEF4-5678-901234567890">
      <Shortcut Id="DesktopShortcut"
                Name="MarkLeaf"
                Target="[INSTALLFOLDER]MarkLeaf.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKMU" Key="Software\MarkLeaf"
                     Name="DesktopInstalled" Value="1" Type="integer" KeyPath="yes" />
      <RemoveFolder Id="RemoveDesktop" Directory="DesktopFolder" On="uninstall" />
    </Component>

    <!-- ===== File Associations ===== -->
    <Component Id="MarkdownFileAssociation" Directory="INSTALLFOLDER"
               Guid="D2A3B4C5-6789-0ABC-DEF1-234567890002">
      <RegistryValue Root="HKLM" Key="Software\Classes\.md"
                     Name="PerceivedType" Value="text" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids"
                     Name="MarkLeaf.MarkdownDoc" Value="" Type="string" />
    </Component>

    <Component Id="MarkdownAltFileAssociation" Directory="INSTALLFOLDER"
               Guid="D3A4B5C6-7890-ABCD-EF12-345678900003">
      <RegistryValue Root="HKLM" Key="Software\Classes\.markdown"
                     Name="PerceivedType" Value="text" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.markdown\OpenWithProgids"
                     Name="MarkLeaf.MarkdownDoc" Value="" Type="string" />
    </Component>

    <Component Id="TextFileAssociation" Directory="INSTALLFOLDER"
               Guid="D4A5B6C7-8901-BCDE-F123-456789000004">
      <RegistryValue Root="HKLM" Key="Software\Classes\.txt"
                     Name="PerceivedType" Value="text" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids"
                     Name="MarkLeaf.MarkdownDoc" Value="" Type="string" />
    </Component>

    <!-- ===== ProgId Registration ===== -->
    <Component Id="ProgIdRegistration" Directory="INSTALLFOLDER"
               Guid="D5A6B7C8-9012-CDEF-1234-567890000005">
      <RegistryValue Root="HKLM" Key="Software\Classes\MarkLeaf.MarkdownDoc"
                     Value="MarkLeaf Markdown Document" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\MarkLeaf.MarkdownDoc\DefaultIcon"
                     Value="[INSTALLFOLDER]Resources\App\fileicon.ico" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\MarkLeaf.MarkdownDoc\shell\open\command"
                     Value="&quot;[INSTALLFOLDER]MarkLeaf.exe&quot; --open-document &quot;%1&quot;" Type="string" />
    </Component>

  </Package>
</Wix>
