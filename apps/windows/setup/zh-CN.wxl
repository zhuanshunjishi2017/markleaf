<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="zh-CN" Codepage="936" xmlns="http://wixtoolset.org/schemas/v4/wxl">

  <!-- Dialog titles -->
  <String Id="WelcomeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}欢迎使用 MarkLeaf [ProductVersion] 安装向导" />
  <String Id="WelcomeDlgDescription" Overridable="yes" Value="此向导将引导您完成 MarkLeaf 的安装。&#10;&#10;建议在安装前关闭所有其它程序，以便直接更新系统文件而无需重新启动计算机。&#10;&#10;单击「下一步」继续。" />

  <String Id="LicenseAgreementDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}最终用户许可协议" />
  <String Id="LicenseAgreementDlgDescription" Overridable="yes" Value="请仔细阅读以下许可协议。" />

  <String Id="SetupTypeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}选择安装类型" />
  <String Id="SetupTypeDlgDescription" Overridable="yes" Value="请选择安装类型。" />

  <String Id="CustomizeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}自定义安装" />
  <String Id="CustomizeDlgDescription" Overridable="yes" Value="选择要安装的功能。" />

  <String Id="InstallDirDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}选择安装目录" />
  <String Id="InstallDirDlgDescription" Overridable="yes" Value="请选择 MarkLeaf 的安装目录。如需安装到其它目录，请单击「浏览」。" />

  <String Id="VerifyReadyDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}已准备好安装 MarkLeaf" />
  <String Id="VerifyReadyDlgDescription" Overridable="yes" Value="单击「安装」开始安装。如需检查或更改安装设置，请单击「上一步」。单击「取消」退出向导。" />

  <String Id="MaintenanceWelcomeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}欢迎使用 MarkLeaf 维护向导" />
  <String Id="MaintenanceWelcomeDlgDescription" Overridable="yes" Value="向导允许您更改 MarkLeaf 的安装方式，或将其从计算机上删除。&#10;&#10;单击「下一步」继续。" />

  <String Id="MaintenanceTypeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}更改、修复或删除安装" />
  <String Id="MaintenanceTypeDlgDescription" Overridable="yes" Value="选择要执行的操作。" />

  <String Id="ProgressDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}正在安装 MarkLeaf" />
  <String Id="ProgressDlgDescription" Overridable="yes" Value="请稍候，向导正在安装 MarkLeaf。" />

  <!-- Exit dialog -->
  <String Id="ExitDialog_Title" Overridable="yes" Value="{\WixUI_Font_Bigger}MarkLeaf 安装完成" />
  <String Id="ExitDialog_Description" Overridable="yes" Value="MarkLeaf 已成功安装。&#10;&#10;单击「完成」退出安装向导。" />

  <!-- Buttons -->
  <String Id="WixUIBack" Overridable="yes" Value="上一步(&amp;B)" />
  <String Id="WixUINext" Overridable="yes" Value="下一步(&amp;N)" />
  <String Id="WixUICancel" Overridable="yes" Value="取消" />
  <String Id="WixUIOK" Overridable="yes" Value="确定" />
