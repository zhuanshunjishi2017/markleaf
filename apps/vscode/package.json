{
  "name": "markleaf",
  "packageManager": "pnpm@11.9.0",
  "displayName": "MarkLeaf",
  "description": "Read and visually edit Markdown with MarkLeaf, using VS Code documents and source editing.",
  "version": "0.2.7",
  "publisher": "markleaf",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "preview",
    "mermaid",
    "katex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuanshunjishi2017/markleaf.git"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configurationDefaults": {
      "workbench.diffEditorAssociations": {
        "*.md": "default",
        "*.markdown": "default"
      }
    },
    "customEditors": [
      {
        "viewType": "markleaf.editor",
        "displayName": "MarkLeaf",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markleaf.open",
        "title": "MarkLeaf: Open Markdown"
      },
      {
        "command": "markleaf.format",
        "title": "MarkLeaf: Format / Paragraph Actions",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleEditor",
        "title": "MarkLeaf: Toggle Source / Rendered View"
      },
      {
        "command": "markleaf.openSource",
        "title": "MarkLeaf: Open Source",
        "icon": "$(code)"
      },
      {
        "command": "markleaf.openSourceBeside",
        "title": "MarkLeaf: Open Source to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "markleaf.insertImage",
        "title": "MarkLeaf: Insert Image from File",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertImageUrl",
        "title": "MarkLeaf: Insert Image URL",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.image",
        "title": "MarkLeaf: Image Actions",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.find",
        "title": "MarkLeaf: Find in Rendered Document",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.replace",
        "title": "MarkLeaf: Replace in Rendered Document",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.copyMarkdown",
        "title": "MarkLeaf: Copy as Markdown",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.copyPlainText",
        "title": "MarkLeaf: Copy as Plain Text",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.copyHtml",
        "title": "MarkLeaf: Copy as HTML",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.pastePlainText",
        "title": "MarkLeaf: Paste Plain Text",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleOutline",
        "title": "MarkLeaf: Toggle Outline",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleFocus",
        "title": "MarkLeaf: Toggle Paragraph Focus",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleTypewriter",
        "title": "MarkLeaf: Toggle Typewriter Scrolling",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleRead",
        "title": "MarkLeaf: Toggle Read / Edit",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.zoomIn",
        "title": "MarkLeaf: Zoom In",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.zoomOut",
        "title": "MarkLeaf: Zoom Out",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.zoomReset",
        "title": "MarkLeaf: Reset Zoom",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.preferences",
        "title": "MarkLeaf: Typography, Theme and Settings",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.help",
        "title": "MarkLeaf: Help",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.shortcuts",
        "title": "MarkLeaf: Configure Shortcuts / 快捷键设置",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleBold",
        "title": "MarkLeaf: 粗体",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleItalic",
        "title": "MarkLeaf: 斜体",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleUnderline",
        "title": "MarkLeaf: 下划线",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleStrike",
        "title": "MarkLeaf: 删除线",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleHighlight",
        "title": "MarkLeaf: 高亮",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleCode",
        "title": "MarkLeaf: 行内代码",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.clearFormat",
        "title": "MarkLeaf: 清除格式",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.formatPainter",
        "title": "MarkLeaf: 格式刷",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setParagraph",
        "title": "MarkLeaf: 正文",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setHeading1",
        "title": "MarkLeaf: 一级标题",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setHeading2",
        "title": "MarkLeaf: 二级标题",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setHeading3",
        "title": "MarkLeaf: 三级标题",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setHeading4",
        "title": "MarkLeaf: 四级标题",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setHeading5",
        "title": "MarkLeaf: 五级标题",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setHeading6",
        "title": "MarkLeaf: 六级标题",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.promoteHeading",
        "title": "MarkLeaf: 提升标题级别",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.demoteHeading",
        "title": "MarkLeaf: 降低标题级别",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertLineBefore",
        "title": "MarkLeaf: 在当前段落前插入",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertLineAfter",
        "title": "MarkLeaf: 在当前段落后插入",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.duplicateParagraph",
        "title": "MarkLeaf: 复制当前段落",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.deleteParagraph",
        "title": "MarkLeaf: 删除当前段落",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleBulletList",
        "title": "MarkLeaf: 无序列表",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleOrderedList",
        "title": "MarkLeaf: 有序列表",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleTaskList",
        "title": "MarkLeaf: 任务列表",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.indentListItem",
        "title": "MarkLeaf: 增加列表缩进",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.outdentListItem",
        "title": "MarkLeaf: 减少列表缩进",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleBlockquote",
        "title": "MarkLeaf: 引用",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.toggleCodeBlock",
        "title": "MarkLeaf: 代码块",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertHorizontalRule",
        "title": "MarkLeaf: 分隔线",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertAlertNote",
        "title": "MarkLeaf: 备注 (NOTE)",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertAlertTip",
        "title": "MarkLeaf: 提示 (TIP)",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertAlertImportant",
        "title": "MarkLeaf: 重要 (IMPORTANT)",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertAlertWarning",
        "title": "MarkLeaf: 警告 (WARNING)",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertAlertCaution",
        "title": "MarkLeaf: 注意 (CAUTION)",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertTable",
        "title": "MarkLeaf: 插入表格…",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.addRowBefore",
        "title": "MarkLeaf: 上方插入行",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.addRowAfter",
        "title": "MarkLeaf: 下方插入行",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.deleteRow",
        "title": "MarkLeaf: 删除行",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.addColumnBefore",
        "title": "MarkLeaf: 左侧插入列",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.addColumnAfter",
        "title": "MarkLeaf: 右侧插入列",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.deleteColumn",
        "title": "MarkLeaf: 删除列",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.alignTableLeft",
        "title": "MarkLeaf: 当前列左对齐",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.alignTableCenter",
        "title": "MarkLeaf: 当前列居中",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.alignTableRight",
        "title": "MarkLeaf: 当前列右对齐",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setTableCaption",
        "title": "MarkLeaf: 表格标题…",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.deleteTable",
        "title": "MarkLeaf: 删除表格",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertMathInline",
        "title": "MarkLeaf: 行内公式",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertMathBlock",
        "title": "MarkLeaf: 独立公式",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertMermaid",
        "title": "MarkLeaf: Mermaid 图表",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.editMath",
        "title": "MarkLeaf: 编辑公式源码",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.convertMath",
        "title": "MarkLeaf: 切换行内 / 独立公式",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setMathNumber",
        "title": "MarkLeaf: 公式编号…",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.deleteMath",
        "title": "MarkLeaf: 删除公式",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.editMermaid",
        "title": "MarkLeaf: 编辑图表源码",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.updateMermaid",
        "title": "MarkLeaf: 渲染当前 Mermaid",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.rerenderMermaid",
        "title": "MarkLeaf: 重新渲染当前图表",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.rerenderAllMermaid",
        "title": "MarkLeaf: 重新渲染所有图表",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.deleteMermaid",
        "title": "MarkLeaf: 删除图表",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.insertFootnote",
        "title": "MarkLeaf: 插入脚注…",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.resetFootnoteLabel",
        "title": "MarkLeaf: 重命名当前脚注…",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.goToFootnoteReference",
        "title": "MarkLeaf: 回到脚注引用",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.clearFootnoteReferences",
        "title": "MarkLeaf: 清除当前脚注引用",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.deleteFootnote",
        "title": "MarkLeaf: 删除脚注",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.showFrontMatter",
        "title": "MarkLeaf: 显示 / 插入 Front Matter",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.setCodeBlockLanguage",
        "title": "MarkLeaf: 代码块语言…",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.copyCodeBlock",
        "title": "MarkLeaf: 复制代码",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.exitCode",
        "title": "MarkLeaf: 退出代码块",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.exportDocument",
        "title": "%command.exportDocument%",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.exportPdf",
        "title": "%command.exportPdf%",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.exportHtml",
        "title": "%command.exportHtml%",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.exportImage",
        "title": "%command.exportImage%",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.print",
        "title": "%command.print%",
        "enablement": "activeCustomEditorId == markleaf.editor"
      },
      {
        "command": "markleaf.exportLast",
        "title": "%command.exportLast%",
        "enablement": "activeCustomEditorId == markleaf.editor"
      }
    ],
    "keybindings": [
      {
        "command": "markleaf.toggleEditor",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markleaf.toggleEditor",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "activeWebviewPanelId == markleaf.editor && markleaf.focus"
      },
      {
        "command": "markleaf.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == markleaf.editor && markleaf.focus"
      },
      {
        "command": "markleaf.replace",
        "key": "ctrl+h",
        "mac": "cmd+alt+f",
        "when": "activeWebviewPanelId == markleaf.editor && markleaf.focus"
      },
      {
        "command": "markleaf.pastePlainText",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "activeWebviewPanelId == markleaf.editor && markleaf.focus == document"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "markleaf.format",
          "when": "webviewId == markleaf.editor && markleafCanEdit",
          "group": "markleaf@1"
        },
        {
          "command": "markleaf.image",
          "when": "webviewId == markleaf.editor && markleafImage",
          "group": "markleaf@2"
        },
        {
          "command": "markleaf.copyMarkdown",
          "when": "webviewId == markleaf.editor",
          "group": "markleaf@2"
        },
        {
          "command": "markleaf.copyPlainText",
          "when": "webviewId == markleaf.editor",
          "group": "markleaf@2"
        },
        {
          "command": "markleaf.copyHtml",
          "when": "webviewId == markleaf.editor",
          "group": "markleaf@2"
        },
        {
          "command": "markleaf.find",
          "when": "webviewId == markleaf.editor",
          "group": "markleaf@2"
        },
        {
          "command": "markleaf.replace",
          "when": "webviewId == markleaf.editor && markleafCanEdit",
          "group": "markleaf@2"
        }
      ],
      "explorer/context": [
        {
          "command": "markleaf.open",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "open@10"
        }
      ],
      "editor/title": [
        {
          "command": "markleaf.open",
          "when": "editorLangId == markdown && activeCustomEditorId != markleaf.editor",
          "group": "navigation"
        },
        {
          "command": "markleaf.openSource",
          "when": "activeCustomEditorId == markleaf.editor",
          "group": "navigation"
        },
        {
          "command": "markleaf.openSourceBeside",
          "when": "activeCustomEditorId == markleaf.editor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MarkLeaf",
      "properties": {
        "markleaf.defaultMode": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "edit",
            "read"
          ],
          "default": "edit",
          "description": "Initial mode for newly opened MarkLeaf editors."
        },
        "markleaf.fontSize": {
          "type": "number",
          "scope": "resource",
          "default": 16,
          "minimum": 10,
          "maximum": 32,
          "description": "Document font size in pixels."
        },
        "markleaf.maxWidth": {
          "type": "number",
          "scope": "resource",
          "default": 820,
          "minimum": 320,
          "maximum": 1600,
          "description": "Maximum document width in pixels."
        },
        "markleaf.lineHeight": {
          "type": "number",
          "scope": "resource",
          "default": 1.75,
          "description": "渲染文档行高。",
          "minimum": 1,
          "maximum": 3
        },
        "markleaf.typography": {
          "type": "string",
          "scope": "resource",
          "default": "minimal",
          "description": "%config.typography%",
          "enum": [
            "sans",
            "serif",
            "print",
            "print-double",
            "latex",
            "retro-print",
            "minimal",
            "magazine",
            "notebook"
          ]
        },
        "markleaf.colorTheme": {
          "type": "string",
          "scope": "resource",
          "default": "vscode",
          "description": "文档配色；vscode 自动跟随当前编辑器主题。",
          "enum": [
            "vscode",
            "default-light",
            "apple-blue",
            "apple-dark",
            "dark",
            "deep-sea",
            "espresso",
            "forest",
            "high-contrast-dark",
            "high-contrast-light",
            "ink",
            "lavender",
            "memo",
            "morandi-cyan",
            "morandi-dark",
            "morandi",
            "pure-black",
            "rose",
            "saltlemon",
            "yellowed-page"
          ]
        },
        "markleaf.fontFamily": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "文档字体 CSS font-family；留空使用排版样式字体。字体须已安装在系统中。"
        },
        "markleaf.sourceFontFamily": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "公式与图表源码编辑器字体；留空跟随 VS Code。普通源码由 VS Code editor.fontFamily 控制。"
        },
        "markleaf.sourceFontSize": {
          "type": "number",
          "scope": "resource",
          "default": 14,
          "description": "公式与图表源码编辑器字号。",
          "minimum": 10,
          "maximum": 32
        },
        "markleaf.cjkLanguage": {
          "type": "string",
          "scope": "resource",
          "default": "zh-Hans",
          "description": "文档中日韩文字的语言标记。",
          "enum": [
            "zh-Hans",
            "zh-Hant",
            "ja",
            "ko"
          ]
        },
        "markleaf.cjkAutoSpacing": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
