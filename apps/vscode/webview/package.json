{
  "name": "@markleaf/vscode-webview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MarkLeaf VS Code 扩展的 webview 适配层：扩展协议、设置、导出与快捷键装配，渲染能力来自 @markleaf/editor-core。",
  "scripts": {
    "build": "tsc --noEmit && vite build",
