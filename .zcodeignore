# Build outputs
**/bin/
**/obj/
**/node_modules/
**/dist/

# IDE and editors
.vs/
.idea/
.vscode/
*.user
*.suo
*.code-workspace
*.DotSettings
*.DotSettings.user

# OS files
**/.DS_Store
**/Thumbs.db

# Logs and temp
*.log
*.tmp
*.tmp_proj
*.vspscc
*.vssscc

# Environment
.env*
*.env

# Test outputs
TestResults/
tests/TestData/*.assets/

# Build artifacts
artifacts/
.artifacts/
.pnpm-store/
.build/

# AI agent files
.claude/
.superpowers/
.codex-build/
/.worktrees/
CLAUDE.md
AGENTS.md
.cursor/
.cursorrules
.codebuddy/
.windsurf/
.roo/
.aider*
.trae/
.augment/
.cline/
.open-repo/
.github/copilot-instructions.md
.github/.copilot*

# App resources (generated)
apps/windows/MarkLeaf/Resources/App/*
!apps/windows/MarkLeaf/Resources/App/App.ico
!apps/windows/MarkLeaf/Resources/App/App.png
!apps/windows/MarkLeaf/Resources/App/fileicon.ico

# Root icon files (keep only appicon.png)
/App.png
/appicon.ico
/fileicon.ico

# Build scripts (user-specific)
/build-dotnet.bat
/build-markleaf.bat
/release.bat

# Installer publish output (generated at build)
apps/windows/setup/publish/
apps/windows/setup/publish-*/
apps/windows/setup/obj/
apps/windows/setup/bin/
apps/windows/setup/*.exe

# MSIX build outputs and local signing credentials
apps/windows/msix/publish-*/
apps/windows/msix/staging-*/
apps/windows/msix/*.msix
apps/windows/msix/*.appx
apps/windows/msix/*.cer
apps/windows/msix/*.pfx
apps/windows/msix/*.log

# Release output
release/

# Keep the macOS release tooling versioned; only generated release output is ignored.
!apps/macos/script/release/
!apps/macos/script/release/**

# Local project notes (not part of the public documentation)
/project-notes/

# Local test change requests are reviewed separately from source history.
[Tt][Cc][Rr]*.md

