  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "4.0.15"
  },
  "packageManager": "pnpm@11.9.0"
}
